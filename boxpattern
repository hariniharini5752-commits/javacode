public class xPattern {
    public static void main(String[] args) {
        int n = 2;
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (j == i || j == n - 1 - i)
   System.out.print("* ");
                else
  System.out.print(" ");
            }
 System.out.println();
        }
        int n2=2;
        for (int i =0; i < n; i++) {
            for (int j = -3; j < n; j++) {
                if (j == i || j == n -1 - i)
   System.out.print("* ");
                else
  System.out.print(" ");
            }
 System.out.println();
        }
    }
}
